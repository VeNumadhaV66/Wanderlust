<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Wanderlust</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/extra.css" />
</head>
<body class="d-flex flex-column min-vh-100">
  <%- include("../includes/navbar.ejs") %>

  <main class="container mt-4 flex-grow-1">
    <% success.forEach(function(m){ %>
      <div class="alert alert-success alert-dismissible fade show" role="alert"><%= m %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    <% }) %>
    <% error.forEach(function(m){ %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= m %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    <% }) %>
    <%- body %>
  </main>

  <%- include("../includes/footer.ejs") %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
