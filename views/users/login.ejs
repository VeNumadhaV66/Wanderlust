<% layout("layouts/boilerplate") %>
<div class="row justify-content-center my-4">
  <div class="col-md-7 col-lg-5">
    <div class="card auth-card border-0">
      <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-1">Welcome back</h1>
        <p class="text-muted mb-4">Log in to add stays and write reviews.</p>
        <form method="POST" action="/login" class="needs-validation" novalidate>
          <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input class="form-control" id="username" name="username" autocomplete="username" required />
            <div class="invalid-feedback">Enter your username.</div>
          </div>
          <div class="mb-4">
            <label class="form-label" for="password">Password</label>
            <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required />
            <div class="invalid-feedback">Enter your password.</div>
          </div>
          <button class="btn btn-brand w-100" type="submit">Log in</button>
        </form>
        <p class="text-center text-muted mt-4 mb-0">New here? <a href="/signup">Create an account</a></p>
      </div>
    </div>
  </div>
</div>
