<% layout("layouts/boilerplate") %>
<div class="row justify-content-center my-4">
  <div class="col-md-7 col-lg-5">
    <div class="card auth-card border-0">
      <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-1">Create your account</h1>
        <p class="text-muted mb-4">It takes a minute. Then you can host and review stays.</p>
        <form method="POST" action="/signup" class="needs-validation" novalidate>
          <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input class="form-control" id="username" name="user[username]" minlength="3" maxlength="30" pattern="[A-Za-z0-9]+" autocomplete="username" required />
            <div class="invalid-feedback">Use 3 to 30 letters or numbers, with no spaces.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <input type="email" class="form-control" id="email" name="user[email]" autocomplete="email" required />
            <div class="invalid-feedback">Enter a valid email address.</div>
          </div>
          <div class="mb-4">
            <label class="form-label" for="password">Password</label>
            <input type="password" class="form-control" id="password" name="user[password]" minlength="6" autocomplete="new-password" required />
            <div class="invalid-feedback">Use at least 6 characters.</div>
          </div>
          <button class="btn btn-brand w-100" type="submit">Sign up</button>
        </form>
        <p class="text-center text-muted mt-4 mb-0">Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>
</div>
