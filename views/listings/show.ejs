<% layout("layouts/boilerplate") %>
<%
  var count = listing.reviews.length;
  var avg = count ? listing.reviews.reduce(function (s, r) { return s + r.rating; }, 0) / count : 0;
  var isOwner = currentUser && listing.owner && listing.owner.equals(currentUser._id);
  var coords = listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2 ? listing.geometry.coordinates : null;
  var words = { 1: "Terrible", 2: "Not good", 3: "Average", 4: "Very good", 5: "Amazing" };
%>

<div class="row justify-content-center">
  <div class="col-lg-8">

    <h1 class="h3 mb-3">
      <%= listing.title %>
      <% if (count) { %>
        <span class="review-summary"><i class="fa-solid fa-star star-on"></i> <%= avg.toFixed(1) %> &middot; <%= count %> review<%= count > 1 ? "s" : "" %></span>
      <% } %>
    </h1>

    <div class="card show-card mb-4">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>" />
      <div class="card-body">
        <p class="owner-line mb-2">Hosted by <b><%= listing.owner ? listing.owner.username : "a Wanderlust host" %></b></p>
        <div class="d-flex flex-wrap gap-2 mb-3">
          <span class="chip"><i class="fa-solid fa-tag"></i> <%= listing.category %></span>
          <span class="chip"><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></span>
        </div>
        <p class="mb-3"><%= listing.description %></p>
        <p class="h5 mb-0">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="price-note fs-6 fw-normal">/ night</span></p>
      </div>
    </div>

    <% if (isOwner) { %>
      <div class="d-flex gap-2 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-brand">Edit listing</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing and its reviews?')">
          <button class="btn btn-outline-danger" type="submit">Delete listing</button>
        </form>
      </div>
    <% } %>

    <hr class="my-4" />

    <% if (currentUser) { %>
      <h2 class="h5 mb-3">Leave a review</h2>
      <form method="POST" action="/listings/<%= listing._id %>/reviews" class="needs-validation mb-5" novalidate>
        <label class="form-label">Rating</label>
        <div class="d-flex align-items-center gap-3 mb-1">
          <div class="star-rating" role="radiogroup" aria-label="Rating">
            <% for (var s = 5; s >= 1; s--) { %>
              <input type="radio" id="star<%= s %>" name="review[rating]" value="<%= s %>" required />
              <label for="star<%= s %>" title="<%= words[s] %>"><i class="fa-solid fa-star"></i></label>
            <% } %>
          </div>
          <span id="ratingText" class="rating-text" aria-live="polite"></span>
        </div>
        <div class="invalid-feedback mb-2">Please choose a rating.</div>

        <label class="form-label mt-2" for="comment">Your review</label>
        <textarea class="form-control mb-1" id="comment" name="review[comment]" rows="3" minlength="3" maxlength="500" required></textarea>
        <div class="invalid-feedback">Write at least 3 characters.</div>

        <button class="btn btn-brand mt-3" type="submit">Post review</button>
      </form>
    <% } else { %>
      <p class="mb-4"><a href="/login">Log in</a> to leave a review.</p>
    <% } %>

    <h2 class="h5 mb-3">Reviews</h2>
    <% if (count === 0) { %><p class="text-muted">No reviews yet. Be the first to share how your stay went.</p><% } %>
    <div class="row g-3 mb-5">
      <% listing.reviews.forEach(function(r){ %>
        <div class="col-md-6">
          <div class="card review-card h-100">
            <div class="card-body">
              <div class="d-flex align-items-center gap-2 mb-2">
                <i class="fa-solid fa-circle-user fa-2x"></i>
                <div>
                  <div class="fw-semibold lh-sm"><%= r.author ? r.author.username : "Deleted user" %></div>
                  <small class="text-muted"><%= new Date(r.createdAt).toLocaleDateString("en-IN", { month: "short", year: "numeric" }) %></small>
                </div>
              </div>
              <div class="mb-2" aria-label="<%= r.rating %> out of 5">
                <% for (var i = 1; i <= 5; i++) { %><i class="fa-solid fa-star <%= i <= r.rating ? 'star-on' : 'star-off' %>"></i><% } %>
              </div>
              <p class="card-text"><%= r.comment %></p>
              <% if (currentUser && r.author && r.author.equals(currentUser._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= r._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-dark" type="submit">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (coords) { %>
      <h2 class="h5 mb-3">Where you'll be</h2>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <div id="map" class="listing-map mb-5"
           data-lat="<%= coords[1] %>" data-lng="<%= coords[0] %>"
           data-title="<%= listing.title %>" data-place="<%= listing.location %>, <%= listing.country %>"></div>
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script src="/js/map.js"></script>
    <% } %>

  </div>
</div>
