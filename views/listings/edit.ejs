<% layout("layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="h3">Edit your listing</h1>
    <p class="text-muted mb-4">Changes appear on your listing page as soon as you save.</p>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data" class="needs-validation mb-5" novalidate>
      <%- include("_form.ejs", { listing: listing }) %>
      <div class="d-flex gap-2">
        <button class="btn btn-brand" type="submit">Save changes</button>
        <a class="btn btn-outline-dark" href="/listings/<%= listing._id %>">Cancel</a>
      </div>
    </form>
  </div>
</div>
