<% layout("layouts/boilerplate") %>
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="h3">Add your home</h1>
    <p class="text-muted mb-4">Add a few details and your stay shows up on the homepage right away.</p>
    <form method="POST" action="/listings" enctype="multipart/form-data" class="needs-validation mb-5" novalidate>
      <%- include("_form.ejs", { listing: { title: "", description: "", price: "", location: "", country: "", category: "", image: null } }) %>
      <button class="btn btn-brand" type="submit">Publish listing</button>
    </form>
  </div>
</div>
